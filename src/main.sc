require: slotfilling/slotFilling.sc
  module = sys.zb-common

# ============================
# Приветствие
# ============================
state: Hello
    q!: $regex</(start|hello)/
    q!: (привет|здравствуй*|добрый день|доброе утро|добрый вечер|хай|здарова|приветствую)
    q!: * привет *

    a: Привет! 👋 Я бот-помощник. Я могу рассказать о погоде 🌤 и курсах валют 💱. Просто спросите!

# ============================
# Погода
# ============================
state: Weather
    q!: (погода|погод*|прогноз погоды)
    q!: * (какая|что) * погод* *
    q!: * (будет|сегодня|завтра) * (дождь|солнце|снег|тепло|холодно) *
    q!: * (расскажи|скажи|подскажи) * погод* *

    a: Сегодня переменная облачность, температура около +18°C, ветер слабый. 🌤 Хорошего дня!

# ============================
# Курс валют
# ============================
state: Currency
    q!: (курс|курсы) * (валют*|доллар*|евро|рубл*)
    q!: * (сколько стоит|какой курс) * (доллар*|евро|валют*) *
    q!: * (доллар|евро|валют*) * курс *
    q!: (доллар*|евро|валют*)

    a: Текущий курс валют 💱:
    a: 💵 1 USD ≈ 90 ₽
    a: 💶 1 EUR ≈ 98 ₽

# ============================
# Обработка исключений
# ============================
state: NoMatch
    event!: noMatch

    a: Извините, я вас не понял. 🤔 Я умею рассказывать о погоде 🌤 и курсах валют 💱. Попробуйте спросить иначе.